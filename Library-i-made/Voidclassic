--// VoidClassic+ Library
--// classic simple, polished, with notifications & optional keysystem

local VoidLib = {}

function VoidLib:CreateWindow(settings)
    settings = settings or {}

    local titleText = settings.Title or "void"
    local loadingTitle = settings.LoadingTitle or "void"
    local loadingSubtitle = settings.LoadingSubtitle or "loading..."

    local keySystemEnabled = settings.KeySystem or false
    local correctKey = settings.Key or "void"
    local keyTitle = settings.KeyTitle or "Key System"
    local keySubtitle = settings.KeySubtitle or "enter key"

    local player = game.Players.LocalPlayer
    local PlayerGui = player:WaitForChild("PlayerGui")

    ----------------------------------------------------------------
    -- LOADING SCREEN
    ----------------------------------------------------------------
    local loadGui = Instance.new("ScreenGui", PlayerGui)
    loadGui.Name = "VoidLoading"

    local loadFrame = Instance.new("Frame", loadGui)
    loadFrame.Size = UDim2.new(1,0,1,0)
    loadFrame.BackgroundColor3 = Color3.fromRGB(10,10,14)

    local loadTitleLbl = Instance.new("TextLabel", loadFrame)
    loadTitleLbl.Size = UDim2.new(1,0,0.5,0)
    loadTitleLbl.BackgroundTransparency = 1
    loadTitleLbl.Text = loadingTitle
    loadTitleLbl.TextColor3 = Color3.new(1,1,1)
    loadTitleLbl.Font = Enum.Font.GothamBold
    loadTitleLbl.TextSize = 26

    local loadSubLbl = Instance.new("TextLabel", loadFrame)
    loadSubLbl.Size = UDim2.new(1,0,0.5,0)
    loadSubLbl.Position = UDim2.new(0,0,0.5,0)
    loadSubLbl.BackgroundTransparency = 1
    loadSubLbl.Text = loadingSubtitle
    loadSubLbl.TextColor3 = Color3.fromRGB(180,180,180)
    loadSubLbl.Font = Enum.Font.Gotham
    loadSubLbl.TextSize = 16

    task.wait(1.2)
    loadGui:Destroy()

    ----------------------------------------------------------------
    -- KEY SYSTEM
    ----------------------------------------------------------------
    if keySystemEnabled then
        local keyGui = Instance.new("ScreenGui", PlayerGui)

        local frame = Instance.new("Frame", keyGui)
        frame.Size = UDim2.new(0,300,0,170)
        frame.Position = UDim2.new(0.5,-150,0.5,-85)
        frame.BackgroundColor3 = Color3.fromRGB(18,18,24)
        Instance.new("UICorner", frame)

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1,0,0,40)
        title.BackgroundTransparency = 1
        title.Text = keyTitle
        title.TextColor3 = Color3.new(1,1,1)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 18

        local sub = Instance.new("TextLabel", frame)
        sub.Size = UDim2.new(1,0,0,30)
        sub.Position = UDim2.new(0,0,0,40)
        sub.BackgroundTransparency = 1
        sub.Text = keySubtitle
        sub.TextColor3 = Color3.fromRGB(180,180,180)
        sub.Font = Enum.Font.Gotham
        sub.TextSize = 14

        local box = Instance.new("TextBox", frame)
        box.Size = UDim2.new(0.85,0,0,40)
        box.Position = UDim2.new(0.075,0,0,80)
        box.PlaceholderText = "Enter key..."
        box.BackgroundColor3 = Color3.fromRGB(30,30,38)
        box.TextColor3 = Color3.new(1,1,1)
        box.Font = Enum.Font.Gotham
        box.TextSize = 14
        Instance.new("UICorner", box)

        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0.85,0,0,35)
        btn.Position = UDim2.new(0.075,0,0,125)
        btn.Text = "Submit"
        btn.BackgroundColor3 = Color3.fromRGB(35,35,45)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        Instance.new("UICorner", btn)

        local unlocked = false

        btn.MouseButton1Click:Connect(function()
            if box.Text == correctKey then
                unlocked = true
                keyGui:Destroy()
            else
                box.Text = ""
                box.PlaceholderText = "Wrong key"
            end
        end)

        repeat task.wait() until unlocked
    end

    ----------------------------------------------------------------
    -- MAIN GUI
    ----------------------------------------------------------------
    local gui = Instance.new("ScreenGui", PlayerGui)
    gui.Name = "VoidClassic"

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,460,0,320)
    main.Position = UDim2.new(0.3,0,0.3,0)
    main.BackgroundColor3 = Color3.fromRGB(18,18,24)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,40)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = Color3.new(1,1,1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18

    ----------------------------------------------------------------
    -- NOTIFICATION SYSTEM
    ----------------------------------------------------------------
    local notifHolder = Instance.new("Frame", gui)
    notifHolder.Position = UDim2.new(1,-260,1,-20)
    notifHolder.Size = UDim2.new(0,240,1,0)
    notifHolder.BackgroundTransparency = 1

    function VoidLib:Notify(text, time)
        time = time or 3

        local notif = Instance.new("TextLabel", notifHolder)
        notif.Size = UDim2.new(1,0,0,40)
        notif.Position = UDim2.new(0,0,1,-60)
        notif.BackgroundColor3 = Color3.fromRGB(25,25,32)
        notif.TextColor3 = Color3.new(1,1,1)
        notif.Font = Enum.Font.Gotham
        notif.TextSize = 14
        notif.Text = "  "..text
        notif.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", notif)

        notif:TweenPosition(UDim2.new(0,0,1,-110),"Out","Quad",0.25,true)

        task.delay(time,function()
            notif:TweenPosition(UDim2.new(0,0,1,-60),"Out","Quad",0.25,true)
            task.wait(0.25)
            notif:Destroy()
        end)
    end

    ----------------------------------------------------------------
    -- TAB SYSTEM + POLISHED LAYOUT
    ----------------------------------------------------------------
    local tabHolder = Instance.new("Frame", main)
    tabHolder.Size = UDim2.new(0,120,1,-40)
    tabHolder.Position = UDim2.new(0,0,0,40)
    tabHolder.BackgroundTransparency = 1

    local content = Instance.new("ScrollingFrame", main)
    content.Size = UDim2.new(1,-120,1,-40)
    content.Position = UDim2.new(0,120,0,40)
    content.CanvasSize = UDim2.new(0,0,0,0)
    content.ScrollBarThickness = 4
    content.BackgroundTransparency = 1

    local layout = Instance.new("UIListLayout", content)
    layout.Padding = UDim.new(0,8)

    local window = {}

    function window:CreateTab(name)
        local btn = Instance.new("TextButton", tabHolder)
        btn.Size = UDim2.new(1,0,0,35)
        btn.Text = name
        btn.BackgroundColor3 = Color3.fromRGB(28,28,34)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        Instance.new("UICorner", btn)

        btn.MouseButton1Click:Connect(function()
            content:ClearAllChildren()
            layout.Parent = content
        end)

        local tab = {}

        function tab:CreateButton(text, callback)
            local b = Instance.new("TextButton", content)
            b.Size = UDim2.new(1,-10,0,40)
            b.Text = text
            b.BackgroundColor3 = Color3.fromRGB(35,35,45)
            b.TextColor3 = Color3.new(1,1,1)
            b.Font = Enum.Font.Gotham
            b.TextSize = 14
            Instance.new("UICorner", b)

            b.MouseButton1Click:Connect(function()
                if callback then callback() end
            end)
        end

        function tab:CreateTextbox(text, callback)
            local box = Instance.new("TextBox", content)
            box.Size = UDim2.new(1,-10,0,40)
            box.PlaceholderText = text
            box.BackgroundColor3 = Color3.fromRGB(35,35,45)
            box.TextColor3 = Color3.new(1,1,1)
            box.Font = Enum.Font.Gotham
            box.TextSize = 14
            Instance.new("UICorner", box)

            box.FocusLost:Connect(function()
                if callback then callback(box.Text) end
            end)
        end

        function tab:CreateText(text)
            local lbl = Instance.new("TextLabel", content)
            lbl.Size = UDim2.new(1,-10,0,30)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = Color3.new(1,1,1)
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 14
        end

        return tab
    end

    return window
end

return VoidLib
